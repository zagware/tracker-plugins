{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/trk-hook.mjs session-start cursor",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/trk-hook.mjs prompt cursor",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/trk-hook.mjs stop cursor",
        "timeout": 10
      }
    ]
  }
}
